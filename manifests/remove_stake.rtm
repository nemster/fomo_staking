CALL_METHOD
	Address("${account}")
	"lock_fee"
	Decimal("10")
;
CALL_METHOD
	Address("${account}")
	"withdraw_non_fungibles"
	Address("${staked_fomo}")
	Array<NonFungibleLocalId>(NonFungibleLocalId("#${nft_id}#"))
;
TAKE_ALL_FROM_WORKTOP
	Address("${staked_fomo}")
	Bucket("tokens")
;
CALL_METHOD
	Address("${component}")
	"remove_stake"
	Bucket("tokens")
	Array<Address>(${ignore_coins})
;
CALL_METHOD
	Address("${account}")
	"deposit_batch"
	Expression("ENTIRE_WORKTOP")
;
